TRADING_MODE=HISTORICAL
AUTO_REAL_MODE_STARTUP_ENABLED=False
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500
DASHBOARD_AUTH_TOKEN=
UT1_NUMERIC_THREADS=1
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
ANGELONE_SECRET_KEY=
CAPITAL_TOTAL=1100000
CAPITAL_FUT=600000
CAPITAL_OPT=500000
FUTURES_SL_PCT=0.10
OPTIONS_SL_PCT=10.0
INST_PREF=OPT
MAX_TRADE_LOSS_ABS=15000
BROKER_FILL_CONFIRMATION_TIMEOUT_SECONDS=12
BROKER_CANCEL_REPLACE_ENABLED=true
ENTRY_MARGIN_BUFFER_PCT=10
ENTRY_MARGIN_CACHE_SECONDS=2
RECOVERY_AUTO_FLATTEN_SECONDS=30
MAX_ENTRY_ORDERS_PER_MINUTE=6
ENTRY_ORDER_RATE_WINDOW_SECONDS=60
ENTRY_ORDER_KILL_LATCH_SECONDS=300
CLOCK_SKEW_MAX_SECONDS=180
SHARED_HOST_MODE=false
ALLOW_PLAINTEXT_BROKER_SECRETS=true

# Upstox live execution and market data
UPSTOX_USER_ID=
# Access tokens expire 03:30 IST daily and Upstox has no refresh token, so this
# cannot run unattended. REDIRECT_URI must match the Upstox app registration exactly.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8500/api/upstox/callback
# Keep delayed Yahoo index quotes disabled for live decisions.
YAHOO_LIVE_PRICE_FALLBACK_ENABLED='False'
